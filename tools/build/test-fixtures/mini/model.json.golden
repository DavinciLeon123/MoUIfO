      "rules": [
        {
          "certainty": "certain",
          "condition": {
            "entity_form": "company"
          },
          "examples": [
            {
              "in": "AB1234",
              "out": "ZZAB1234"
            }
          ],
          "id": "beta-from-alpha",
          "input": "alpha",
          "output": "beta",
          "source": "mini-analysis",
          "transform": [
            {
              "add_prefix": "ZZ"
            }
          ]
        }
      ]
