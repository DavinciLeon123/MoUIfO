          "capture": {
            "group": 1,
            "regex": "^([A-Z]{2})"
          },
          "certainty": "certain",
          "map": "country-prefix",
          "source": "mini-analysis"
        }
      },
      "format": {
        "checksum": [
          {
            "algorithm": "mini-check",
            "certainty": "possible",
            "over": [
              {
                "capture": {
                  "group": 1,
                  "regex": "^[A-Z]{2}([0-9]{4})$"
                }
              }
            ],
            "source": "mini-analysis"
          }
        ],
        "examples_invalid": [
          "1234AB"
        ],
        "examples_valid": [
          "AB1234"
        ],
        "patterns": [
          {
            "certainty": "certain",
            "regex": "^[A-Z]{2}[0-9]{4}$",
            "source": "mini-analysis"
          },
          {
            "certainty": "likely",
            "condition": {
              "entity_form": "company",
              "issuing_country": "AA"
            },
            "note": "A longer form for companies.",
            "regex": "^[A-Z]{2}[0-9]{5}$",
            "source": "mini-analysis"
          }
        ]
      },
