{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vocab-certainty.schema.json",
  "description": "The certainty vocabulary: a closed list of levels with a rank (SPEC 5.1).",
  "type": "object",
  "properties": {
    "id": { "const": "certainty" },
    "label": { "$ref": "common.schema.json#/$defs/label" },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/kebab-id" },
          "label": { "$ref": "common.schema.json#/$defs/label" },
          "definition": { "$ref": "common.schema.json#/$defs/text" },
          "rank": { "type": "integer", "minimum": 1 }
        },
        "required": ["id", "label", "definition", "rank"],
        "unevaluatedProperties": false
      }
    }
  },
  "required": ["id", "label", "values"],
  "unevaluatedProperties": false
}
