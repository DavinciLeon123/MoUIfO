{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "description": "A source: the page, standard, register document, analysis or expert statement a model statement cites (SPEC 5.4, DEC-030). The date is the version date the cited page states for the text read; when the page states none, the instrument's adoption or Royal Assent date; for a register-doc, the page's last-updated date. An expert source names a role and an organisation, never a person.",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/kebab-id" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "enum": ["law", "standard", "register-doc", "expert", "analysis"] },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "eli": { "type": "string", "format": "uri" },
    "publisher": { "type": "string", "minLength": 1 },
    "reference": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "organisation": { "type": "string", "minLength": 1 }
  },
  "required": ["id", "title", "date", "type"],
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "law" } }, "required": ["type"] },
      "then": { "type": "object", "anyOf": [{ "required": ["eli"] }, { "required": ["url"] }] }
    },
    {
      "if": { "properties": { "type": { "const": "standard" } }, "required": ["type"] },
      "then": { "type": "object", "required": ["publisher", "reference"] }
    },
    {
      "if": { "properties": { "type": { "const": "register-doc" } }, "required": ["type"] },
      "then": { "type": "object", "required": ["url"] }
    },
    {
      "if": { "properties": { "type": { "const": "analysis" } }, "required": ["type"] },
      "then": { "type": "object", "required": ["method"] }
    },
    {
      "if": { "properties": { "type": { "const": "expert" } }, "required": ["type"] },
      "then": { "type": "object", "required": ["role", "organisation"] }
    }
  ],
  "unevaluatedProperties": false
}
